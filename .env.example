# Braintree sandbox credentials (Control Panel -> Settings -> API)
BT_ENVIRONMENT=sandbox
BT_MERCHANT_ID=
BT_PUBLIC_KEY=
BT_PRIVATE_KEY=
# Braintree publishes no rate limit; the PayPal sandbox blocks an IP for 5 minutes after
# 50 requests in a minute. One call per 1.5 s is 40/min. On a 429, wait out the block and retry once.
BT_MIN_INTERVAL_S=1.5
BT_RATE_LIMIT_BACKOFF_S=330

# Claude auditor. Credentials resolve from ANTHROPIC_API_KEY or an `ant auth login` profile.
AUDITOR_MODEL=claude-opus-5-5
AUDITOR_EFFORT=medium
# Recommendations below this confidence are escalated to a human instead of executed.
AUDITOR_MIN_CONFIDENCE=0.7

# Secret for per-session pseudonymous IDs. Any random string; rotate per run if you like.
PSEUDONYM_SECRET=change-me

# SQLite file for tokens, orders, events and the audit log.
TXAUDIT_DB=txaudit.db
